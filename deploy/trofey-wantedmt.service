[Unit]
# The nightly delivery on the Fedora host (#4): the store that GitHub Actions folded and
# published becomes the registry behind the Trofey IMEI check, and the quality report the
# morning site build serves. No folding happens here — see scripts/deliver.sh.
Description=wantedmt: deliver the published registry to Trofey
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=re
# systemd's default PATH has no ~/.local/bin, where uv lives; an interactive ssh gets it
# from the profile, which is why the manual run passed and the 13:00 one did not (#11).
Environment=PATH=/home/re/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Called through bash on purpose: the executable bit is a mode git keeps losing between
# a Windows checkout and a Linux clone, and it did — the first install landed a 644 file
# and the unit would have failed at 04:00 with nothing but a permission error to show.
ExecStart=/bin/bash /opt/wantedmt/scripts/deliver.sh
# A full run is ~15s; the ceiling is for the 270 MB download on a bad night.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
